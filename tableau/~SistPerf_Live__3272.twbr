            <column-instance column='[Assessment]' derivation='None' name='[none:Assessment:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1000000015838]' derivation='None' name='[none:Calculation_1000000015838:nk]' pivot='key' type='nominal' />
