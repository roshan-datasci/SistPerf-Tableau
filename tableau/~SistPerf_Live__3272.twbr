            <column caption='Grade' datatype='string' name='[Calculation_1000000071271]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1000000063352] = 0 THEN &quot;Pending&quot; ELSEIF [Calculation_1000000055433] &lt; 0.3 OR [Calculation_1000000047514] &lt; 0.5 THEN &quot;RA&quot; ELSEIF [Calculation_1000000047514] &gt;= 0.9 THEN &quot;A++&quot; ELSEIF [Calculation_1000000047514] &gt;= 0.8 THEN &quot;A+&quot; ELSEIF [Calculation_1000000047514] &gt;= 0.7 THEN &quot;B++&quot; ELSEIF [Calculation_1000000047514] &gt;= 0.6 THEN &quot;B+&quot; ELSE &quot;C&quot; END' />
            </column>
            <column caption='Grade Points' datatype='integer' name='[Calculation_1000000079190]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Calculation_1000000071271] WHEN &quot;A++&quot; THEN 10 WHEN &quot;A+&quot; THEN 9 WHEN &quot;B++&quot; THEN 8 WHEN &quot;B+&quot; THEN 7 WHEN &quot;C&quot; THEN 6 ELSE 0 END' />
            </column>
            <column caption='Credit Points' datatype='real' name='[Calculation_1000000087109]' role='measure' type='quantitative'>
