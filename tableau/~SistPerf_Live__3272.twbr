          </datasources>
          <datasource-dependencies datasource='federated.sistperf0marks0long'>
            <column datatype='string' name='[Assessment]' role='dimension' type='nominal' />
            <column caption='Total Marks' datatype='real' name='[Calculation_1000000031676]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [Student_ID],[Semester],[Subject_Code] : SUM(IF [Assessment] = &quot;Internal&quot; OR [Assessment] = &quot;Exam&quot; THEN [Marks] END)}' />
            </column>
            <column caption='Total Max' datatype='real' name='[Calculation_1000000039595]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [Student_ID],[Semester],[Subject_Code] : SUM(IF [Assessment] = &quot;Internal&quot; OR [Assessment] = &quot;Exam&quot; THEN [Maximum_Marks] END)}' />
            </column>
            <column caption='Subject Total %' datatype='real' default-format='p0.0%' name='[Calculation_1000000047514]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1000000031676] / [Calculation_1000000039595]' />
            </column>
            <column caption='Exam %' datatype='real' default-format='p0.0%' name='[Calculation_1000000055433]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [Student_ID],[Semester],[Subject_Code] : SUM(IF [Assessment] = &quot;Exam&quot; THEN [Marks] END)} / {FIXED [Student_ID],[Semester],[Subject_Code] : SUM(IF [Assessment] = &quot;Exam&quot; THEN [Maximum_Marks] END)}' />
            </column>
            <column caption='Has Exam' datatype='integer' name='[Calculation_1000000063352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [Student_ID],[Semester],[Subject_Code] : MAX(IF [Assessment] = &quot;Exam&quot; THEN 1 ELSE 0 END)}' />
            </column>
            <column caption='Grade' datatype='string' name='[Calculation_1000000071271]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1000000063352] = 0 THEN &quot;Pending&quot; ELSEIF [Calculation_1000000055433] &lt; 0.3 OR [Calculation_1000000047514] &lt; 0.5 THEN &quot;RA&quot; ELSEIF [Calculation_1000000047514] &gt;= 0.9 THEN &quot;A++&quot; ELSEIF [Calculation_1000000047514] &gt;= 0.8 THEN &quot;A+&quot; ELSEIF [Calculation_1000000047514] &gt;= 0.7 THEN &quot;B++&quot; ELSEIF [Calculation_1000000047514] &gt;= 0.6 THEN &quot;B+&quot; ELSE &quot;C&quot; END' />
            </column>
            <column caption='Grade Points' datatype='integer' name='[Calculation_1000000079190]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Calculation_1000000071271] WHEN &quot;A++&quot; THEN 10 WHEN &quot;A+&quot; THEN 9 WHEN &quot;B++&quot; THEN 8 WHEN &quot;B+&quot; THEN 7 WHEN &quot;C&quot; THEN 6 ELSE 0 END' />
            </column>
            <column caption='Credit Points' datatype='real' name='[Calculation_1000000087109]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Assessment] = &quot;Exam&quot; AND [Calculation_1000000071271] &lt;&gt; &quot;RA&quot; AND [Calculation_1000000071271] &lt;&gt; &quot;Pending&quot; THEN [Calculation_1000000079190] * [Credits] END' />
            </column>
            <column caption='Credits Cleared' datatype='real' name='[Calculation_1000000095028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Assessment] = &quot;Exam&quot; AND [Calculation_1000000071271] &lt;&gt; &quot;RA&quot; AND [Calculation_1000000071271] &lt;&gt; &quot;Pending&quot; THEN [Credits] END' />
            </column>
            <column caption='SGPA' datatype='real' default-format='0.00' name='[Calculation_1000000102947]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1000000087109]) / SUM([Calculation_1000000095028])' />
            </column>
            <column datatype='real' name='[Credits]' role='measure' type='quantitative' />
            <column datatype='real' name='[Marks]' role='measure' type='quantitative' />
            <column datatype='real' name='[Maximum_Marks]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Semester]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Semester_Label]' role='dimension' type='nominal' />
            <column datatype='string' name='[Student_ID]' role='dimension' type='nominal' />
            <column datatype='string' name='[Subject_Code]' role='dimension' type='nominal' />
            <column-instance column='[Semester_Label]' derivation='None' name='[none:Semester_Label:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1000000102947]' derivation='User' name='[usr:Calculation_1000000102947:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.sistperf0marks0long].[usr:Calculation_1000000102947:qk]</rows>
        <cols>[federated.sistperf0marks0long].[none:Semester_Label:nk]</cols>
